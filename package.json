{
  "name": "pi-agent-ask",
  "version": "1.2.7",
  "description": "Let your Pi agent ask instead of guessing, keep working, and remember your answers.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexshpunt/pi-agent-ask.git"
  },
  "homepage": "https://github.com/alexshpunt/pi-agent-ask#readme",
  "bugs": {
    "url": "https://github.com/alexshpunt/pi-agent-ask/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "pi-agent",
    "ai-agent",
    "coding-agent",
    "agentic-coding",
    "agent-tools",
    "ask-user",
    "clarification",
    "human-in-the-loop",
    "user-input",
    "decision-making",
    "background-questions",
    "questionnaire",
    "session-history",
    "markdown-export",
    "terminal-ui",
    "typescript"
  ],
  "files": [
    "src/",
    "skills/",
    "assets/ask.webp",
    "assets/ask-gallery.webp",
    "docs/configuration.md",
    "docs/contract.md",
    "docs/remote-events.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "sh -c 'ROOT=\"$PWD\"; TARGET=\"${1:-.}\"; if [ \"$TARGET\" = \"--\" ]; then TARGET=\"${2:-.}\"; fi; cd \"$TARGET\" && pi --no-extensions --no-skills --no-prompt-templates --no-themes --no-context-files -e \"$ROOT/src/index.ts\" --skill \"$ROOT/skills/ask-user\"' --",
    "test": "node --test tests/*.test.ts",
    "test:integration": "pi-test run -- node --test tests/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "ultracite check",
    "check:ci": "biome ci .",
    "fix": "ultracite fix",
    "commit": "cz",
    "commitlint": "commitlint"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/alexshpunt/pi-agent-ask/main/assets/ask-gallery.webp"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "25.6.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^2.1.6",
    "pi-coding-agent-test": "0.1.3",
    "typebox": "1.3.7",
    "typescript": "6.0.2",
    "ultracite": "7.6.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ],
    "overrides": {
      "@earendil-works/pi-agent-core": "1.0.0",
      "@earendil-works/pi-ai": "1.0.0",
      "@earendil-works/pi-tui": "1.0.0",
      "@earendil-works/pi-coding-agent": "1.0.0"
    },
    "ignoredBuiltDependencies": [
      "lefthook"
    ]
  }
}
